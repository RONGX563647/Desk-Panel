{
  "name": "desk-panel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node server/index.js\" \"vite\"",
    "build": "vite build",
    "build:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File desktop/build.ps1",
    "test": "node --test",
    "start": "node server/index.js",
    "serve": "npm run build && node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
